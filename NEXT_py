class KernelManager:
"""Gère le kernel et l'initramfs."""

def __init__(self, project: OSProject):
self.project = project
self.build_dir = BUILDS_DIR / project.id

def prepare(self):
"""Prépare le kernel et l'initramfs."""
try:
self.project.add_log("🔧 Préparation kernel...")

# Kernel : on utilise un stub symbolique
kernel_path = self.build_dir / "vmlinuz"
self._create_kernel_stub(kernel_path)
self.project.kernel_path = str(kernel_path)
self.project.add_log(f" Kernel: {kernel_path}")

# Initramfs
rootfs = self.build_dir / "rootfs"
if rootfs.exists():
initramfs_path = self.build_dir / "initramfs.cpio.gz"
self._create_initramfs(rootfs, initramfs_path)
self.project.initramfs_path = str(initramfs_path)
self.project.add_log(f" Initramfs: {initramfs_path}")

except Exception as e:
self.project.add_log(f"❌ Kernel: {e}")

def _create_kernel_stub(self, path: Path):
"""Crée un stub de kernel (pas de vrai kernel)."""
content = f"""# NEXUS OS KERNEL STUB
# Version: {VERSION}
# Built: {datetime.now().isoformat()}
#
# Ce fichier est un placeholder. Pour un vrai kernel :
# 1. Télécharger linux-6.x depuis kernel.org
# 2. make defconfig
# 3. make -j$(nproc)
# 4. cp arch/x86/boot/bzImage vmlinuz
"""
path.write_text(content)

def _create_initramfs(self, rootfs: Path, output: Path):
"""Crée un initramfs (cpio.gz)."""
try:
# Copier /init en tête
tmp = tempfile.mkdtemp(prefix="initramfs_")
tmp_path = Path(tmp)

shutil.copytree(rootfs, tmp_path / "rootfs")
os.chdir(tmp_path / "rootfs")

# Créer le cpio
result = subprocess.run(
["find", ".", "-print0"],
capture_output=True,
timeout=30,
)
if result.returncode != 0:
raise RuntimeError("find échoué")

files = result.stdout.split(b'\0')
files = [f for f in files if f]

# Écrire cpio
cpio_path = tmp_path / "initramfs.cpio"
with open(cpio_path, "wb") as cpio:
for fpath in files:
try:
st = os.lstat(fpath)
if stat.S_ISDIR(st.st_mode):
continue
# Header cpio newc
name = fpath.decode('utf-8', errors='ignore')
if name.startswith('./'):
name = name[2:]
ino = st.st_ino & 0xFFFFFFFF
mode = st.st_mode & 0xFFFFFFFF
uid = st.st_uid & 0xFFFFFFFF
gid = st.st_gid & 0xFFFFFFFF
nlink = 1
mtime = int(st.st_mtime)
size = st.st_size
devmaj = (st.st_dev >> 8) & 0xFF
devmin = st.st_dev & 0xFF
name_bytes = name.encode('utf-8') + b'\0'

hdr = (
b'070701' +
format(ino, '08X').encode() +
format(mode, '08X').encode() +
format(uid, '08X').encode() +
format(gid, '08X').encode() +
format(nlink, '08X').encode() +
format(mtime, '08X').encode() +
format(size, '08X').encode() +
format(devmaj, '08X').encode() +
format(devmin, '08X').encode() +
format(0, '08X').encode() +
format(0, '08X').encode() +
format(0, '08X').encode() +
format(0, '08X').encode() +
format(len(name_bytes), '08X').encode() +
format(0, '08X').encode() +
name_bytes
)
cpio.write(hdr)
with open(fpath, 'rb') as f:
cpio.write(f.read())
pad = (4 - (len(hdr) + size) % 4) % 4
cpio.write(b'\0' * pad)
except:
continue

# Trailer
cpio.write(b'070701' + b'0' * 104 + b'TRAILER!!!\0')
pad = (4 - (len(cpio.getbuffer()) % 4)) % 4
cpio.write(b'\0' * pad)

# Gzip
with open(cpio_path, 'rb') as f_in:
with gzip.open(output, 'wb') as f_out:
shutil.copyfileobj(f_in, f_out)

shutil.rmtree(tmp_path)

except Exception as e:
self.project.add_log(f" ⚠ Initramfs: {e}")


