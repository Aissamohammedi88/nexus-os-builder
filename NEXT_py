class SystemUtils:
"""Utilitaires de détection système."""

@staticmethod
def detect_platform() -> Dict[str, Any]:
"""Détecte la plateforme actuelle."""
is_ios = "ios" in sys.platform.lower() or "darwin" in sys.platform and \
os.environ.get("SHELL", "").endswith("a-shell")
return {
"os": platform.system(),
"release": platform.release(),
"machine": platform.machine(),
"python": platform.python_version(),
"is_ios": is_ios,
"is_linux": sys.platform.startswith("linux"),
"is_macos": sys.platform == "darwin",
"is_windows": sys.platform == "win32",
"has_genisoimage": shutil.which("genisoimage") is not None,
"has_mkisofs": shutil.which("mkisofs") is not None,
"has_qemu": shutil.which("qemu-system-x86_64") is not None,
}

@staticmethod
def find_writable_dir() -> Path:
"""Trouve un dossier inscriptible."""
candidates = [
os.getenv("NEXUS_DIR"),
os.path.expanduser("~/nexus_build"),
os.path.join(tempfile.gettempdir(), "nexus_build"),
os.path.expanduser("~/Documents/nexus_build"),
os.path.join(os.getcwd(), "nexus_build"),
]
for c in candidates:
if not c:
continue
try:
p = Path(c)
p.mkdir(parents=True, exist_ok=True)
test = p / ".write_test"
test.write_text("x")
test.unlink()
return p
except (OSError, PermissionError):
continue
raise RuntimeError("Aucun dossier inscriptible trouvé")


