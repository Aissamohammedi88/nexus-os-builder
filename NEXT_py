# ROOTFS ASSEMBLER
# ═══════════════════════════════════════════════════════════════════════════════

class RootFSAssembler:
"""Assemble un rootfs Linux minimal."""

BASE_DIRS = [
"bin", "sbin", "etc", "proc", "sys", "dev", "tmp", "run",
"root", "home", "home/nexus", "var", "var/log", "var/cache",
"var/tmp", "usr", "usr/bin", "usr/sbin", "usr/lib", "usr/share",
"opt", "srv", "mnt", "media", "lib", "lib64",
]

def __init__(self, project: OSProject):
self.project = project
self.rootfs = BUILDS_DIR / project.id / "rootfs"

def assemble(self) -> Optional[Path]:
"""Assemble le rootfs complet."""
try:
self.project.add_log(f"📁 Assemblage rootfs: {self.distro_cmd()}")

# Nettoyage
if self.rootfs.exists():
shutil.rmtree(self.rootfs)
self.rootfs.mkdir(parents=True, exist_ok=True)

# 1. Arborescence
self._create_directories()

# 2. Init
self._create_init()

# 3. Shell
self._create_shell()

# 4. Fichiers système
self._create_system_files()

# 5. Outils NEXUS
self._create_nexus_tools()

# 6. Recipe-specific
self._apply_recipe()

# 7. README
self._create_readme()

self.project.add_log(f"✓ Rootfs assemblé: {self._count_files()} fichiers")
return self.rootfs

except Exception as e:
self.project.add_log(f"❌ Rootfs: {e}")
traceback.print_exc()
return None

def distro_cmd(self) -> str:
return self.project.distro

def _create_directories(self):
for d in self.BASE_DIRS:
(self.rootfs / d).mkdir(parents=True, exist_ok=True)

def _create_init(self):
recipe = RECIPES.get(self.project.name)
pkg_list = ", ".join(recipe.packages[:5]) if recipe else ""

init = f"""#!/bin/sh
# NEXUS OS v{VERSION}
# Build: {datetime.now().isoformat()}
# Distro: {self.project.distro}
# Recipe: {self.project.name}

export PATH=/bin:/sbin:/usr/bin:/usr/sbin
export HOME=/root
export PS1='nexus@os:\\w# '
export TERM=linux

# Mount virtual filesystems
mount -t proc proc /proc 2>/dev/null
mount -t sysfs sysfs /sys 2>/dev/null
mount -t devtmpfs devtmpfs /dev 2>/dev/null
mount -t tmpfs tmpfs /tmp 2>/dev/null
mount -t tmpfs tmpfs /run 2>/dev/null

# Load modules
for mod in $(ls /lib/modules 2>/dev/null); do
modprobe $mod 2>/dev/null
done

# Hostname
hostname nexus 2>/dev/null

clear 2>/dev/null || true

echo ""
echo "╔════════════════════════════════════════════════════════════╗"
echo "║ ║"
echo "║ 🚀 NEXUS OS v{VERSION} ║"
echo "║ ║"
echo "║ Name : {self.project.name:<43}║"
echo "║ Distro : {self.project.distro:<43}║"
echo "║ Recipe : {pkg_list[:43]:<43}║"
echo "║ ║"
echo "╚════════════════════════════════════════════════════════════╝"
echo ""
echo " Fichiers : $(find / -type f 2>/dev/null | wc -l)"
echo " Uptime : $(cat /proc/uptime 2>/dev/null | cut -d' ' -f1)s"
echo " Kernel : $(uname -r)"
echo ""
echo " Tape 'nexus-help' pour l'aide"
echo ""

exec /bin/sh
"""
init_path = self.rootfs / "init"
init_path.write_text(init)
os.chmod(init_path, 0o755)

def _create_shell(self):
sh = """#!/bin/sh
# NEXUS Shell — minimal
export PATH=/bin:/sbin:/usr/bin:/usr/sbin
export HOME=/root

while true; do
printf "nexus@os:\\w# "
read -r cmd args

case "$cmd" in
exit|quit)
echo "Arrêt..."
poweroff -f 2>/dev/null || exit 0
;;
help|nexus-help)
echo ""
echo "NEXUS OS — Commandes disponibles :"
echo " help Cette aide"
echo " info Info système"
echo " ls [dir] Liste fichiers"
echo " cat [file] Affiche fichier"
echo " cd [dir] Change dossier"
echo " pwd Dossier courant"
echo " ps Processus"
echo " free Mémoire"
echo " df Disque"
echo " uname -a Info kernel"
echo " exit Quitter"
echo ""
;;
info)
echo "════════════════════════════════════════"
echo " NEXUS OS v{VERSION}"
echo " Recipe: {recipe}"
echo " Distro: {distro}"
echo " Kernel: $(uname -r)"
echo " Uptime: $(cat /proc/uptime 2>/dev/null | cut -d' ' -f1)s"
echo "════════════════════════════════════════"
;;
ls)
ls $args 2>/dev/null || echo "Erreur ls"
;;
cat)
cat $args 2>/dev/null || echo "Erreur cat"
;;
cd)
