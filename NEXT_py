class BootImageBuilder:
"""Construit l'image bootable finale."""

def __init__(self, project: OSProject):
self.project = project
self.build_dir = BUILDS_DIR / project.id
self.exports_dir = EXPORTS_DIR

def build(self, rootfs: Path):
"""Construit l'archive finale."""
try:
self.project.add_log("📦 Construction archive...")

archive_name = f"{self.project.name}_{self.project.id}.tar.xz"
archive_path = self.exports_dir / archive_name

with tarfile.open(archive_path, "w:xz", preset=6) as tar:
tar.add(self.build_dir, arcname=self.project.name)

size_kb = archive_path.stat().st_size // 1024
self.project.archive_path = str(archive_path)
self.project.size_kb = size_kb
self.project.files_count = sum(
1 for _ in self.build_dir.rglob("*") if _.is_file()
)

self.project.add_log(
f"✓ Archive: {archive_path} ({size_kb} KB, "
f"{self.project.files_count} fichiers)"
)

# Générer ISO si disponible
if shutil.which("genisoimage") or shutil.which("mkisofs"):
iso_name = f"{self.project.name}_{self.project.id}.iso"
iso_path = self.exports_dir / iso_name
self._build_iso(iso_path)

except Exception as e:
self.project.add_log(f"❌ Archive: {e}")

def _build_iso(self, path: Path):
"""Génère une ISO si genisoimage dispo."""
try:
cmd = shutil.which("genisoimage") or shutil.which("mkisofs")
subprocess.run(
[
cmd,
"-o", str(path),
"-V", f"NEXUS_{self.project.id}",
"-R", "-J", "-joliet-long",
str(self.build_dir / "rootfs"),
],
capture_output=True,
timeout=120,
)
if path.exists():
self.project.add_log(f"✓ ISO: {path}")
except Exception as e:
self.project.add_log(f"⚠ ISO: {e}")


