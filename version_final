class CLI:
"""Interface CLI."""

@staticmethod
def build(name: str, distro: str, prompt: str) -> int:
print(f"🔨 Build: {name} ({distro})")
print(f" Prompt: {prompt[:80]}")
print()

factory = OSFactory()
project = factory.create_project(name, distro, prompt)

Try:
project.status = "BUILDING"
project.start_time = datetime.now().isoformat()

print("[1/4] RootFS assembly...")
project.set_progress(10, "RootFS")
rootfs = RootFSAssembler(project).assemble()
if not rootfs:
print("❌ RootFS échoué")
return 1

print("[2/4] Kernel + Initramfs...")
project.set_progress(50, "Kernel")
km = KernelManager(project)
km.prepare()

print("[3/4] Boot image...")
project.set_progress(80, "Boot image")
bi = BootImageBuilder(project)
bi.build(rootfs)

print("[4/4] Completed.")
project.set_progress(100, "Done")
project.status = "COMPLETED"
project.end_time = datetime.now().isoformat()

print()
print("✅ Built Success!")
if project.archive_path:
print(f" 📦 Archive: {project.archive_path}")
if project.iso_path:
print(f" 💿 ISO: {project.iso_path}")
if project.kernel_path:
print(f" 🔧 Kernel: {project.kernel_path}")
if project.initramfs_path:
print(f" 💾 Initramfs: {project.initramfs_path}")

return 0

Except Exception as e:
print(f"❌ Failure: {e}")
traceback.print_exc()
return 1

@staticmethod
def list_recipes() -> int:
print(f"📚 Available Recipes ({len(RECIPES.list_all())))):")
print()

by_cat = defaultdict(list)
for name, recipe in RECIPES.list_all().items():
by_cat[recipe.category].append(recipe)

for category in sorted(by_cat.keys()):
print(f" [{category.upper()}]")
for recipe in by_cat[category]:
size = f"~{recipe.size_estimate_kb} KB" if recipe.size_estimate_kb else ""
print(f" • {recipe.name:<20} {recipe.description[:60]:<60} {size}")
print()
return 0

@staticmethod
def list_providers() -> int:
print(f"🔌 Providers API ({len(PROVIDERS)}):")
print()

by_cat = REGISTRY.by_category()
for category in sorted(by_cat.keys()):
print(f" [{category.upper()}]")
for p in by_cat[category]:
configured = "✓" if os.getenv(p.env_var) else "○"
print(f" {configured} {p.name:<20} {p.default_model:<30} {p.env_var}")
print()
return 0


