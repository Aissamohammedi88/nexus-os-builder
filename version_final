"etc/fstab": "proc /proc proc defaults 0 0\nsysfs /sys sysfs defaults 0 0\ndevtmpfs /dev devtmpfs defaults 0 0\n",
"etc/issue": f"NEXUS OS v{VERSION} — {self.project.name}\\n",
