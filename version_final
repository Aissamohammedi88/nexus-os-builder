class OSFactory:
"""Factory of OS Projects."""

def __init__(self):
self.projects: Dict[str, OSProject] = {}
self.lock = threading.Rlock()

def create_project(self, name: str, distro: str, prompt: str) -> OSProject:
"""Crée un projet."""
pid = str(uuid.uuid4())[:8]
project = OSProject(pid, name, distro, prompt)
With self.lock:
self.projects[pid] = project
JOURNAL.log(f"Project created: {name} ({pid})", "INFO", "factory")
return project

def get_project(self, pid: str) -> Optional[OSProject]:
With self.lock:
return self.projects.get(pid)

def list_projects(self) -> List[Dict[str, Any]]:
With self.lock:
return [p.to_dict() for p in self.projects.values()]

def build_async(self, project: OSProject):
"""Throw the build in the background.""
thread = threading.Thread(target=self._build, args=(project,), daemon=True)
thread.start()

def _build(self, project: OSProject):
"""Build complet."""
Try:
project.status = "BUILDING"
project.start_time = datetime.now().isoformat()
project.add_log(f"🚀 Build démarré : {project.name}")
project.add_log(f"📦 Distro : {project.distro}")

#1. RootFS
project.set_progress(10, "RootFS")
project.add_log("📁 Assemblage rootfs")
rootfs = RootFSAssembler(project).assemble()
if not rootfs:
raise RuntimeError("RootFS échoué")

# 2. Kernel
project.set_progress(50, "Kernel")
project.add_log("🔧 Préparation kernel")
km = KernelManager(project)
km.prepare()
project.kernel_path = str(km.kernel_path) if km.kernel_path None else
project.initramfs_path = str(km.initramfs_path) if km.initramfs_path else None

#3. Boot image
project.set_progress(80, "Boot image")
project.add_log("💿 Construction boot image")
bi = BootImageBuilder(project)
bi.build(rootfs)

#4. Stats
if project.archive_path:
p = Path(project.archive_path)
if p.exists():
project.size_kb = p.stat().st_size // 1024

#5. Done
project.set_progress(100, "Completed")
project.status = "COMPLETED"
project.end_time = datetime.now().isoformat()
project.add_log("🎉 Build successfully completed")

Except Exception as e:
project.status = "FAILED"
project.error = str(e)
project.add_log(f"💥 Error : {e}")
JOURNAL.log(f"Build failed {project.id} : {e}", "ERROR", "build")
JOURNAL.log(traceback.format_exc()[:500], "ERROR", "build")


