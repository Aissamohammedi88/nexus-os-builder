@staticmethod
def detect_platform() -> Dict[str, Any]:
""""Detects the platform."""
info = {
"os": platform.system(),
"release": platform.release(),
"machine": platform.machine(),
"python": f"{sys.version_info.major}.{sys.version_info.minor}.{sys.version_info.micro}",
"is_ios": sys.platform == "ios" or "iPhone" in platform.machine(),
"is_android": "ANDROID_ROOT" in os.environment or "android" in platform.platform().lower(),
"has_genisoimage": shutil.which("genisoimage") is not None,
"has_mkisofs": shutil.which("mkisofs") is not None,
"has_xorriso": shutil.which("xorriso") is not None,
"has_qemu": shutil.which("qemu-system-x86_64") is not None,
}
return info

@staticmethod
def run_command(cmd: List[str], timeout: int = 60, cwd: Optional[str] = None) -> Dict[str, Any]:
"""Executes a command."""
Try:
r = subprocess.run(
cmd, capture_output=True, text=True, timeout=timeout, cwd=cwd
)
return {
"ok": r.returncode == 0,
"stdout": r.stdout,
"stderr": r.stderr,
"code": r.returncode,
}
except subprocess.TimeoutExpired:
return {"ok": False, "stdout": "", "stderr": "timeout", "code": 124}
except FileNotFoundError:
return {"ok": False, "stdout": "", "stderr": "command not found", "code": 127}
Except Exception as e:
return {"ok": False, "stdout": "", "stderr": str(e), "code": 1}

@staticmethod
def sha256_file(path: Path) -> str:
"""Hash SHA-256 d'un fichier."""
h = hashlib.sha256()
with open(path, "rb") as f:
for chunk in iter(lambda: f.read(65536), b""):
h.update(chunk)
return h.hexdigest()


