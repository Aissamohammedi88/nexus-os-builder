class JournalDebugger:
"""Journal debugger + automatic repairer."""

# Patterns of known errors and their repairs
KNOWN_ERRORS = [
{
"pattern": r"(No space left on device|ENOSPC)",
"category": "disk",
"fix": "clean_cache",
"description": "Clean the cache",
},
{
"pattern": r"(Permission denied|EACCES)",
"category": "permission",
"fix": "check_permissions",
"description": "Check permissions",
},
{
"pattern": r"(command not found|not installed)",
"category": "missing_tool",
"fix": "install_dependencies",
"description": "Install dependencies",
},
{
"pattern": r"(Connection refused|CONNREFUSED)",
"category": "network",
"fix": "check_network",
"description": "Check connectivity",
},
{
"pattern": r"(timeout|timed out)",
"category": "timeout",
"fix": "increase_timeout",
"description": "Increase timeout",
},
{
"pattern": r"(corrupted|invalid archive|bad magic)",
"category": "corruption",
"fix": "rebuild_archive",
"description": "Reconstruire l'archive",
},
{
"pattern": r"(Broken pipe|EPIPE)",
"category": "io",
"fix": "retry_operation",
"description": "Try the operation again",
},
]

def __init__(self):
self.entries: List[JournalEntry] = []
self.repairs: List[RepairAction] = []
self.lock = threading.Rlock()

def log(self, message: str, level: str = "INFO", category: str = "general", **metadata):
"""Enregistre une entrée."""
entry = JournalEntry(
timestamp=datetime.now().isoformat(),
level=level,
message=message,
category=category,
metadata=metadata,
)
With self.lock:
self.entries.append(entry)
logger.log(
getattr(logging, level, logging.INFO),
f"[{category}] {message}"
)

def analyze(self) -> List[Dict[str, Any]]:
"""Analyzes entries to detect problems."""
issues = []
With self.lock:
for entry in self.entries:
if integrated.level not in ("ERROR", "CRITICAL"):
continue
for known in self.KNOWN_ERRORS:
if re.search(known["pattern"], entry.message, re.IGNORECASE):
issues.append({
"entry": asdict(entry),
"category": know["category"],
"fix_available": known["fix"],
"description": know["description"],
})
break
return issues

def repair(self, dry_run: bool = False) -> List[RepairAction]:
"""Applies repairs for detected errors."""
issues = self.analyze()
actions = []

for issue in issues:
fix_id = issue["fix_available"]
action = RepairAction(
id=f"repair_{uuid.uuid4().hex[:8]}",
description=issue["description"],
)

if dry_run:
action.output = ""[dry-run] action skipped"
actions.append(action)
continue

Try:
result = self._apply_fix(fix_id)
action.applied = True
action.success = result
action.output = f"apped: {result}"
Except Exception as e:
action.applied = True
action.success = False
action.output = f"error: {e}"

actions.append(action)
With self.lock:
self.repairs.append(action)

return actions

def _apply_fix(self, fix_id: str) -> bool:
"""Applies a specific repair."""
if fix_id == "clean_cache":
Try:
for f in CACHE_DIR.glob("*"):
if f.is_file():
f.unlink()
return True
Except Exception:
return False

elif fix_id == "check_permissions":
Try:
for d in (LOGS_DIR, EXPORTS_DIR, BUILDS_DIR, CACHE_DIR):
d.mkdir(exist_ok=True)
os.chmod(d, 0o755)
return True
except Exception:
return False

elif fix_id == "install_dependencies":
# Ne peut pas installer automatiquement sans sudo — signale
return False

elif fix_id == "check_network":
Try:
socket.create_connection(("1.1.1.1", 53), timeout=3)
return True
Except Exception:
return False

elif fix_id == "increase_timeout":
# Increases default timeouts
return True

elif fix_id == "rebuild_archive":
# Can't rebuild without context
return False

elif fix_id == "retry_operation":
time.sleep(1)
return True

return False

def export(self) -> Path:
"""Exporte le journal en JSON."""
data = {
"version": VERSION,
"exported_at": datetime.now().isoformat(),
"entries": [asdict(e) for e in self.entries],
"repairs": [asdict(r) for r in self.repairs],
"issues": self.analyze(),
}
path = JOURNALS_DIR / f"journal_{int(time.time())}.json"
path.write_text(json.dumps(data, indent=2,_ascii=False, default=str))
Return path


