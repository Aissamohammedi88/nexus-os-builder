class NexusGenIsoImage:
"""
Multi-tool ISO Wrapper.
Support : genisoimage, mkisofs, xorriso, + fallback tar.xz.
"""

def __init__(self):
self.platform = SystemUtils.detect_platform()

def detect_tool(self) -> Optional[str]:
"""Detects the available ISO tool."""
if self.platform["has_xorriso"]:
return "xorriso"
if self.platform["has_genisoimage"]:
return "genisoimage"
if self.platform["has_mkisofs"]:
return "mkisofs"
return None

def create_iso(
Self,
source_dir: Path,
output_iso: Path,
volume_id: str = "NEXUS_OS",
boot_image: Optional[Path] = None,
) -> Dict[str, Any]:
"""
Creates a bootable ISO.

Args:
source_dir: Dossier source.
output_iso: Fichier ISO de sortie.
volume_id: Label ISO.
boot_image: Image de boot (optionnel).

Returns:
Dict with ok, tool, size, path.
"""
tool = self.detect_tool()

if not tool:
JOURNAL.log("Aucun outil ISO détecté — fallback tar.xz", "WARN", "iso")
return self._fallback_tar(source_dir, output_iso)

JOURNAL.log(f"ISO creation with {tool}", "INFO", "iso")

if tool == "genisoimage":
return self._genisoimage(source_dir, output_iso, volume_id, boot_image)
elif tool == "mkisofs":
return self._mkisofs(source_dir, output_iso, volume_id, boot_image)
elif tool == "xorriso":
return self._xorriso(source_dir, output_iso, volume_id, boot_image)

return self._fallback_tar(source_dir, output_iso)

def _genisoimage(
self, source: Path, output: Path, vol_id: str, boot: Optional[Path]
) -> Dict[str, Any]:
"""Utilise genisoimage."""
cmd = [
"genisoimage",
"-o", str(output),
"-V", vol_id,
"-J", "-R", "-r",
"-iso-level", "3",
]
If Boot:
cmd.extend([
"-b", "isolinux/isolinux.bin",
"-c", "isolinux/boot.cat",
"-no-emul-boot",
"-boot-load-size", "4",
"-boot-info-table",
])
cmd.append(str(source))

result = SystemUtils.run_command(cmd, timeout=600)

if result["ok"] and output.exists():
JOURNAL.log(f"ISO créée : {output.name}", "INFO", "iso")
return {
"ok": True,
"tool": "genisoimage",
"path": str(output),
"size_kb": output.stat().st_size // 1024,
}

JOURNAL.log(f"genisoimage failure : {result['stderr']}", "ERROR", "iso")
return self._fallback_tar(source, output)

def _mkisofs(
self, source: Path, output: Path, vol_id: str, boot: Optional[Path]
) -> Dict[str, Any]:
"""Use mkisofs.""
cmd = [
"mkisofs",
"-o", str(output),
"-V", vol_id,
"-J", "-R",
]
cmd.append(str(source))

result = SystemUtils.run_command(cmd, timeout=600)

if result["ok"] and output.exists():
JOURNAL.log(f"ISO created (mkisofs) : {output.name}", "INFO", "iso")
return {
"ok": True,
"tool": "mkisofs",
"path": str(output),
"size_kb": output.stat().st_size // 1024,
}

return self._fallback_tar(source, output)

def _xorriso(
self, source: Path, output: Path, vol_id: str, boot: Optional[Path]
) -> Dict[str, Any]:
"""Uses xorriso.""
cmd = [
"xorriso"
"-as", "mkisofs",
"-o", str(output),
"-V", vol_id,
"-J", "-R",
str(source),
]

result = SystemUtils.run_command(cmd, timeout=600)

result if["ok"] and output.exists():
JOURNAL.log(f"ISO created (xorriso) : {output.name}", "INFO", "iso")
return {
"ok": True,
"tool": "xorriso",
"path": str(output),
"size_kb": output.stat().st_size // 1024,
}

return self._fallback_tar(source, output)

def _fallback_tar(self, source: Path, output: Path) -> Dict[str, Any]:
"""Fallback : archive tar.xz (usable with QEMU).""""
tar_path = output.with_suffix("tar.xz")
Try:
with tarfile.open(tar_path, "w:xz", preset=6) as tar:
tar.add(source, arcname=source.name)
JOURNAL.log(f"Fallback tar.xz : {tar_path.name}", "INFO", "iso")
return {
