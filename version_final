class RootFSAssembler:
"""Assembles a minimal rootfs."""

def __init__(self, project):
self.project = project
self.rootfs: Optional[Path] = None

def assemble(self) -> Optional[Path]:
"""Assembles the rootfs.""
Try:
build_dir = BUILDS_DIR / self.project.id
build_dir.mkdir(parents=True, exist_ok=True)
self.rootfs = build_dir / "rootfs"
self.rootfs.mkdir(exist_ok=True)

self._create_structure()
self._create_init()
self._create_shell()
self._create_system_files()
self._create_nexus_tools()
self._create_readme()

JOURNAL.log(f"RootFS assemblé : {self.rootfs}", "INFO", "rootfs")
return self.rootfs

Except Exception as e:
JOURNAL.log(f"RootFS échec : {e}", "ERROR", "rootfs")
self.project.error = str(e)
return None

def _create_structure(self):
"""Crée l'arborescence."""
dirs = [
"bin", "sbin", "etc", "proc", "sys", "dev", "tmp", "run",
"root", "home", "home/nexus", "var", "var/log", "usr",
"usr/bin", "usr/sbin", "usr/lib", "opt", "srv", "mnt", "media",
"etc/nexus", "etc/init.d",
]
for d in dirs:
(self.rootfs / d).mkdir(parents=True, exist_ok=True)

def _create_init(self):
"""Create /init.""
init_content = f"""#! /bin/sh
# NEXUS OS {VERSION} — {self.project.name}
# Heir: {HEIR}

export PATH=/bin:/sbin:/usr/bin:/usr/sbin
export HOME=/root
export PS1='nexus@os:\\w#'

mount -t proc proc /proc 2>/dev/null
mount -t sysfs sysfs /sys 2>/dev/null
mount -t devtmpfs devtmpfs /dev 2>/dev/null
mount -t tmpfs tmpfs /tmp 2>/dev/null

clear 2>/dev/null || true

echo ""
echo "═══════════════════════════════╕══╕═╕��
echo "║ ║"
echo "║ NEXUS OS v{VERSION} ║"
echo "║ {self.project.name:<44}║"
echo "║ Distro: {self.project.distro:<37}║"
echo "║ Heir: {HEIR:<35}║"
echo "║ ║"
echo "╚════════════════════════════════════════════════════════════╝"
echo ""

if [ -f /etc/nexus/welcome ]; then
cat /etc/nexus/welcome
fi

echo ""
echo "Shell interactive - /bin/sh"
echo ""

exec /bin/sh
"""
init = self.rootfs / "init"
init.write_text(init_content)
os.chmod(init, 0o755)

def _create_shell(self):
"""Create /bin/sh minimal."""
sh_content = """#!/bin/sh
# NEXUS minimal shell
While true; do
printf "nexus@os:# "
read cmd 2>/dev/null || exit 0
box "$cmd" in
exit|quit) exit 0 ;;
help) echo "Commandes: exit, help, info, ls, echo, uname, cat, mount" ;;
info)
echo "════════════════════════════════════════"
echo "NEXUS OS"
cat /etc/nexus-release 2>/dev/null
echo "════════════════════════════════════════"
;;
ls) ls -la 2>/dev/null || echo "bin etc home proc root sys tmp usr var" ;;
uname) uname -a 2>/dev/null || echo "Linux nexus 5.x" ;;
cat\ *) eval "cat $cmd" 2>/dev/null ;;
mount) cat /proc/mounts 2>/dev/null ;;
"") ;;
*) echo "nexus: $cmd — non disponible en mode minimal" ;;
esac
done
"""
sh = self.rootfs / "bin/sh"
sh.write_text(sh_content)
os.chmod(sh, 0o755)

# Copie dans /usr/bin/sh
usr_sh = self.rootfs / "usr/bin/sh"
shutil.copy(sh, usr_sh)
os.chmod(usr_sh, 0o755)

def _create_system_files(self):
"""Creates system files."""
files = {
"etc/passwd": "root:x:0:0:root:/root:/bin/sh\nnexus:x:1000:1000:Nexus:/home/nexus:/bin/sh\nnobody:x:65534:65534:nobody:/:/bin/false\n",
"etc/group": "root:x:0:\nnexus:x:1000:\nwheel:x:10:nexus\nnobody:x:65534:\n",
"etc/shadow": "root:*:19000:0:99999:7::\nnexus:*:19000:0:99999:7::\n",
"etc/hostname": f"nexus-{self.project.id}\n",
