class KernelManager:
"""Prepared kernel + initramfs."""

def __init__(self, project):
self.project = project
self.kernel_path: Optional[Path] = None
self.initramfs_path: Optional[Path] = None

def prepare(self) -> bool:
"""Prépare kernel et initramfs."""
Try:
build_dir = BUILDS_DIR / self.project.id
build_dir.mkdir(parents=True, exist_ok=True)

# Look for a system kernel
kernel = self._find_system_kernel()
if kernel:
self.kernel_path = build_dir / "vmlinuz"
shutil.copy(kernel, self.kernel_path)
JOURNAL.log(f"Kernel copié : {kernel}", "INFO", "kernel")
else:
# Crée un faux kernel (stub)
self.kernel_path = build_dir / "vmlinuz"
self.kernel_path.write_bytes(b"NEXUS_KERNEL_STUB" + b"\x00" * 1024)
JOURNAL.log("Kernel stub créé (pas de kernel système)", "WARN", "kernel")

# Creates initrams
self._create_initramfs(build_dir)
return True

Except Exception as e:
JOURNAL.log(f"Kernel prep failure : {e}", "ERROR", "kernel")
return False

def _find_system_kernel(self) -> Optional[Path]:
"""Trouve un kernel système."""
candidates = [
"/boot/vmlinuz",
"/boot/vmlinuz-linux",
f"/boot/vmlinuz-{platform.release()}",
]
for c in candidates:
p = Path(c)
if p.exists():
return p
return None

def _create_initramfs(self, build_dir: Path):
"""Creates an initramfs cpio.gz."""
Try:
rootfs = build_dir / "rootfs"
if not rootfs.exists():
return

cpio_path = build_dir / "initramfs.cpio"
gz_path = build_dir / "initramfs.cpio.gz"

# Liste tous les fichiers
files = []
for f in rootfs.rglob("*"):
if f.is_file():
rel = f.relative_to(rootfs)
files.append((f, rel))

# Writes a simple newc copy
with open(cpio_path, "wb") as out:
for f, rel in files:
stat = f.stat()
name = str(rel).encode()
name_b = name + b"\x00"
# cpio newc header (110 bytes)
hdr = (
b"070701"
+ f"{int(stat.st_ino) & 0xFFFFFFFF:08X}".encode()
+ f"{stat.st_mode & 0xFFFFFFFF:08X}".encode()
+ b"00000000" # uid
+ b"00000000" # gid
+ b"00000001" # nlink
+ b"00000000" # mtime
+ f"{stat.st_size & 0xFFFFFFFF:08X}".encode()
+ b"00000000" # devmajor
+ b"00000000" # devminor
+ b"00000000" # rdevmajor
+ b"00000000" # rdevminor
+ f"{len(name_b) & 0xFFFFFFFF:08X}".encode()
+ b"000000000" # check
)
out.write(hdr)
out.write(name_b)
# Padding 4-byte align
pad = (4 - (len(hdr) + len(name_b)) % 4%
out.write(b"\x00" * pad)
# Data
out.write(f.read_bytes())
pad = (4 - stat.st_size % 4) % 4
out.write(b"\x00" * pad)

# Trailer
trailer = (
b"070701"
+ b"00000000" * 8
+ b"00000001" # nlink
+ b"00000000" * 4
+ b"0000000B" # name size = 11 (TRAILER!!!)
+ b"00000000"
)
out.write(trailer)
out.write(b"TRAILER!!!\x00")
pad = (4 - (len(trailer) + 11) % 4) % 4
out.write(b"\x00" * pad)

# Compress
with open(cpio_path, "rb") as f_in, gzip.open(gz_path, "wb") as f_out:
shutil.copyfileobj(f_in, f_out)

self.initramfs_path = gz_path
JOURNAL.log(f"Initramfs created : {gz_path}", "INFO", "kernel")

Except Exception as e:
JOURNAL.log(f"Initramfs failure: {e}", "ERROR", "kernel")


