"tool": "tar.xz",
"path": str(tar_path),
"size_kb": tar_path.stat().st_size // 1024,
"note": "Utilisable avec QEMU: qemu-system-x86_64 -kernel vmlinuz -initrd initramfs -hda ...",
}
Except Exception as e:
JOURNAL.log(f"Fallback tar.xz failed : {e}", "ERROR", "iso")
return {"ok": False, "error": str(e)}


