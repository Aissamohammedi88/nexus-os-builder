class Handler(BaseHTTPRequestHandler):
factory: Optional[OSFactory] = None

def log_message(self, *args):
Pass

def _send_json(self, code: int, data: Any):
Try:
body = json.dumps(data, ensure_ascii=False, default=str).encode("utf-8")
self.send_response(code)
self.send_header("Content-Type", "application/json; charset=utf-8")
self.send_header("Access-Control-Allow-Origin", "*")
self.send_header("Content-Length", str(len(body)))
self.end_headers()
self.wfile.write(body)
except (BrokenPipeError, ConnectionResetError):
Pass

def _send_html(self, code: int, html: str):
Try:
body = html.encode("utf-8")
self.send_response(code)
self.send_header("Content-Type", "text/html; charset=utf-8")
self.send_header("Content-Length", str(len(body)))
self.end_headers()
self.wfile.write(body)
except (BrokenPipeError, ConnectionResetError):
Pass

def _send_file(self, path: str, filename: Optional[str] = None):
Try:
p = Path(path)
if not p.exists():
self._send_json(404, {"error": "file not found"})
return
self.send_response(200)
self.send_header("Content-Type", "application/octet-stream")
self.send_header(
"Content-Disposition",
f'attachment; filename="{filename or p.name}"'
)
self.send_header("Content-Length", str(p.stat().st_size))
self.end_headers()
with open(p, "rb") as f:
shutil.copyfileobj(f, self.wfile)
except (BrokenPipeError, ConnectionResetError):
Pass
Except Exception as e:
Try:
self._send_json(500, {"error": str(e)})
Except:
Pass

def do_GET(self):
Try:
parsed = urlparse(self.path)
path = parsed.path

if path == "/":
html = HTML_TEMPLATE.replace("__V__", VERSION)
self._send_html(200, html)

elif path == "/api/projects":
self._send_json(200, self.factory.list_projects())

elif path == "/api/version":
self._send_json(200, {
"version": VERSION,
"author": AUTEUR,
"year": HEIR,
"license": LICENCE,
"providers": len(PROVIDERS),
"platform": SystemUtils.detect_platform(),
})

elif path == "/api/providers":
self._send_json(200, REGISTRY.list_all())

elif path == "/api/recipes":
recipes = RECIPES.list_all()
self._send_json(200, {k: v.to_dict() for k, v in recipes.items()})

elif path == "/api/categories":
self._send_json(200, RECIPES.list_categories())

elif path == "/api/journal":
self._send_json(200, {
"entries": [asdict(e) for e in JOURNAL.entries[-100:]],
"issues": JOURNAL.analyze(),
"repairs": [asdict(r) for r in JOURNAL.repairs[-20:]],
})

elif path.startswith("/download/"):
parts = path.split("/")
if len(parts) >= 4:
pid = parts[2]
kind = parts[3]
project = self.factory.get_project(pid)

if project:
if kind == "archive" and project.archive_path:
self._send_file(project.archive_path)
elif kind == "kernel" and project.kernel_path:
self._send_file(project.kernel_path)
elif kind == "initramfs" and project.initramfs_path:
self._send_file(project.initramfs_path)
elif kind == "iso" and project.iso_path:
self._send_file(project.iso_path)
else:
self._send_json(404, {"error": "file not ready"})
else:
self._send_json(404, {"error": "project not found"})
else:
self._send_json(400, {"error": "bad request"})

else:
self._send_json(404, {"error": "not found"})

except (BrokenPipeError, ConnectionResetError):
Pass
Except Exception as e:
logger.error(f"GET error: {e}")
Try:
self._send_json(500, {"error": str(e)})
Except:
Pass

def do_POST(self):
Try:
parsed = urlparse(self.path)
path = parsed.path

if path == "/api/build":
n = int(self.headers.get("Content-Length", 0))
body = self.rfile.read(n)
data = json.loads(body.decode() or "{}")

project = self.factory.create_project(
data.get("name", "NexusOS"),
data.get("distro", "alpine"),
data.get("prompt", ""),
)
self.factory.build_async(project)
self._send_json(200, project.to_dict())

elif path == "/api/repair":
n = int(self.headers.get("Content-Length", 0))
body = self.rfile.read(n)
data = json.loads(body.decode() or "{}")
dry_run = data.get("dry_run", False)
actions = JOURNAL.repair(dry_run=dry_run)
self._send_json(200, [asdict(a) for a in actions])

elif path == "/api/journal/export":
path_exported = JOURNAL.export()
self._send_json(200, {"path": str(path_exported)})

else:
self._send_json(404, {"error": "not found"})

except (BrokenPipeError, ConnectionResetError):
Pass
Except Exception as e:
logger.error(f"POST error: {e}")
Try:
self._send_json(500, {"error": str(e)})
Except:
Pass


class Server(ThreadingHTTPServer):
daemon_threads = True
allow_reuse_address = True


