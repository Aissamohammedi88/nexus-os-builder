class BootImageBuilder:
"""Construit l'image de boot."""

def __init__(self, project: OSProject):
self.project = project

def build(self, rootfs: Path) -> bool:
"""Construit l'image finale."""
try:
build_dir = BUILDS_DIR / self.project.id
self.project.add_log("📦 Création archive .tar.xz...")

archive_name = f"{self.project.name}_{self.project.id}.tar.xz"
archive_path = EXPORTS_DIR / archive_name

with tarfile.open(archive_path, "w:xz", preset=6) as tar:
# Ajouter le rootfs
tar.add(rootfs, arcname="rootfs")

# Ajouter le noyau
if self.project.kernel_path and Path(self.project.kernel_path).exists():
tar.add(self.project.kernel_path, arcname="vmlinuz")

# Ajouter l'initramfs
if self.project.initramfs_path and Path(self.project.initramfs_path).exists():
tar.add(self.project.initramfs_path, arcname="initramfs.cpio.gz")

# Stats
self.project.archive_path = str(archive_path)
self.project.size_kb = archive_path.stat().st_size // 1024
self.project.files_count = sum(1 for _ in rootfs.rglob("*") if _.is_file())

self.project.add_log(
f"✓ Archive: {self.project.size_kb} KB, "
f"{self.project.files_count} fichiers"
)

return True

except Exception as e:
self.project.add_log(f"💥 Boot erreur: {e}")
return False


