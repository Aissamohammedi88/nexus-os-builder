class OSFactory:
"""Usine de construction d'OS."""

def __init__(self):
self.projects: Dict[str, OSProject] = {}
self.lock = threading.RLock()

def create_project(self, name: str, distro: str, prompt: str) -> OSProject:
"""Crée un nouveau projet."""
pid = str(uuid.uuid4())[:8]
project = OSProject(
id=pid,
name=name,
distro=distro,
prompt=prompt,
start_time=datetime.now().isoformat(),
)
with self.lock:
self.projects[pid] = project
logger.info(f"Projet créé: {pid} ({name}, {distro})")
return project

def get_project(self, pid: str) -> Optional[OSProject]:
with self.lock:
return self.projects.get(pid)

def list_projects(self) -> List[Dict]:
with self.lock:
projects = sorted(
self.projects.values(),
key=lambda p: p.start_time or "",
reverse=True
)
return [p.to_dict() for p in projects]

def build_async(self, project: OSProject):
"""Lance le build en arrière-plan."""
thread = threading.Thread(target=self._build_worker, args=(project,), daemon=True)
thread.start()

def _build_worker(self, project: OSProject):
"""Worker de build."""
try:
project.status = "BUILDING"
project.add_log(f"🚀 Démarrage build: {project.name}")
project.add_log(f"📦 Distro: {project.distro}")
project.add_log(f"🎯 Prompt: {project.prompt[:60]}")

# RootFS
project.set_progress(10, "RootFS")
rootfs = RootFSAssembler(project).assemble()
if not rootfs:
project.status = "FAILED"
project.error = "RootFS échoué"
return

# Kernel
project.set_progress(60, "Kernel")
if not KernelManager(project).prepare():
project.status = "FAILED"
project.error = "Kernel échoué"
return

# Boot image
project.set_progress(80, "Boot image")
if not BootImageBuilder(project).build(rootfs):
project.status = "FAILED"
project.error = "Boot image échoué"
return

project.set_progress(100, "Terminé")
project.status = "COMPLETED"
project.end_time = datetime.now().isoformat()
project.add_log("🎉 Build terminé avec succès!")
project.add_log(f"📥 Télécharge: /download/{project.id}/archive")

except Exception as e:
project.status = "FAILED"
project.error = str(e)
project.add_log(f"💥 ERREUR: {e}")
project.add_log(traceback.format_exc()[:300])


