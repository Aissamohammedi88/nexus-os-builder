args = parser.parse_args()

print_banner()

if args.list_recipes:
CLI.list_recipes()
return 0

if args.command == "build":
return CLI.build(args.name, args.distro, args.prompt)

# Mode serveur web
platform_info = SystemUtils.detect_platform()

print(" Plateforme détectée :")
print(f" OS : {platform_info['os']} {platform_info['release']}")
print(f" Machine : {platform_info['machine']}")
print(f" Python : {platform_info['python']}")
print(f" iOS : {'Oui' if platform_info['is_ios'] else 'Non'}")
print()

print(f" Recipes : {len(RECIPES.list_all())} disponibles")
print(f" Categories : {', '.join(RECIPES.list_categories())}")
print()

print(f" Base dir : {BASE_DIR}")
print(f" Cache : {CACHE_DIR}")
print(f" URL : http://{args.host}:{args.port}")
print()

if not platform_info["has_genisoimage"] and not platform_info["has_mkisofs"]:
print(" ℹ genisoimage non installé — l'archive .tar.xz sera générée")
print(" (utilisable directement avec QEMU)")
print()

print(" Ctrl+C pour arrêter.")
print()

factory = OSFactory()
Handler.factory = factory

try:
server = Server((args.host, args.port), Handler)
server.serve_forever()
except KeyboardInterrupt:
print("\n\n 👋 Arrêt demandé.")
try:
server.shutdown()
except:
pass
except OSError as e:
print(f"\n ❌ Erreur port {args.port}: {e}")
print(f" Essaie: python3 nexus_os_builder.py --port 9999")
