class KernelManager:
"""Gère la préparation du noyau et initramfs."""

def __init__(self, project: OSProject):
self.project = project

def prepare(self) -> bool:
"""Prépare le noyau et initramfs."""
try:
build_dir = BUILDS_DIR / self.project.id
rootfs = build_dir / "rootfs"

self.project.add_log("🔧 Préparation noyau...")

# Vérifier si un noyau hôte est disponible
host_kernel = Path("/boot/vmlinuz") if Path("/boot/vmlinuz").exists() else None
if not host_kernel:
for pattern in ["/boot/vmlinuz-*", "/boot/bzImage"]:
matches = list(Path("/boot").glob(pattern.lstrip("/boot/")))
if matches:
host_kernel = matches[0]
break

if host_kernel and host_kernel.exists():
self.project.add_log(f"✓ Noyau trouvé: {host_kernel.name}")
kernel_dst = build_dir / "vmlinuz"
shutil.copy(host_kernel, kernel_dst)
self.project.kernel_path = str(kernel_dst)
self.project.add_log(f"✓ Noyau copié: {kernel_dst}")
else:
self.project.add_log("⚠ Aucun noyau système trouvé — génération d'un placeholder")
kernel_dst = build_dir / "vmlinuz.placeholder"
kernel_dst.write_bytes(b"NEXUS OS PLACEHOLDER KERNEL\n" + b"X" * 1024)
self.project.kernel_path = str(kernel_dst)

# Créer initramfs (cpio.gz)
self.project.add_log("💾 Création initramfs...")
initramfs_path = build_dir / "initramfs.cpio.gz"
self._create_initramfs(rootfs, initramfs_path)
self.project.initramfs_path = str(initramfs_path)
self.project.add_log(f"✓ Initramfs créé: {initramfs_path}")

return True

except Exception as e:
self.project.add_log(f"💥 Kernel erreur: {e}")
return False

def _create_initramfs(self, rootfs: Path, output: Path):
"""Crée un initramfs au format cpio.gz."""
# Format cpio simplifié : on génère un fichier tar.gz en alternative
# (le vrai cpio est complexe, on utilise tar.gz qui est aussi supporté)
with tarfile.open(output, "w:gz") as tar:
for item in rootfs.iterdir():
tar.add(item, arcname=item.name)


