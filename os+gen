class RootFSAssembler:
"""Assemble un RootFS minimal."""

LINUX_DIRS = [
"bin", "sbin", "lib", "lib64", "usr", "usr/bin", "usr/sbin",
"usr/lib", "usr/share", "etc", "etc/init.d", "etc/nexus",
"var", "var/log", "var/tmp", "var/cache", "var/lib",
"tmp", "run", "root", "home", "home/nexus",
"proc", "sys", "dev", "boot", "opt", "srv", "mnt", "media",
]

def __init__(self, project: OSProject):
self.project = project
self.rootfs: Optional[Path] = None

def assemble(self) -> Optional[Path]:
"""Assemble le RootFS."""
try:
self.project.set_progress(10, "RootFS - Structure")
self.project.add_log("📁 Création arborescence")

build_dir = BUILDS_DIR / self.project.id
build_dir.mkdir(parents=True, exist_ok=True)
self.rootfs = build_dir / "rootfs"

if self.rootfs.exists():
shutil.rmtree(self.rootfs)
self.rootfs.mkdir(parents=True)

# Créer les dossiers
for d in self.LINUX_DIRS:
(self.rootfs / d).mkdir(parents=True, exist_ok=True)

# Fichiers système
self.project.set_progress(20, "RootFS - Fichiers système")
self.project.add_log("📝 Fichiers /etc")
self._create_system_files()

# Init
self.project.set_progress(30, "RootFS - Init")
self.project.add_log("🔧 Création /init")
self._create_init()

# Shell
self.project.set_progress(40, "RootFS - Shell")
self.project.add_log("🐚 Création /bin/sh")
self._create_shell()

# Outils Nexus
self.project.set_progress(50, "RootFS - Outils")
self.project.add_log("🔧 Outils NEXUS")
self._create_nexus_tools()

return self.rootfs

except Exception as e:
self.project.add_log(f"💥 RootFS erreur: {e}")
return None

def _create_system_files(self):
"""Crée les fichiers système standards."""
files = {
"etc/passwd": (
"root:x:0:0:root:/root:/bin/sh\n"
"nexus:x:1000:1000:Nexus:/home/nexus:/bin/sh\n"
"nobody:x:65534:65534:nobody:/:/bin/false\n"
),
"etc/group": (
"root:x:0:\n"
"nexus:x:1000:\n"
"wheel:x:10:nexus\n"
"nobody:x:65534:\n"
),
"etc/shadow": (
"root:*:19000:0:99999:7:::\n"
"nexus:*:19000:0:99999:7:::\n"
),
"etc/hostname": f"nexus-{self.project.id}\n",
"etc/hosts": (
"127.0.0.1\tlocalhost\n"
"127.0.1.1\tnexus\n"
"::1\t\tlocalhost\n"
),
"etc/resolv.conf": (
"nameserver 1.1.1.1\n"
"nameserver 8.8.8.8\n"
),
"etc/fstab": (
"proc /proc proc defaults 0 0\n"
"sysfs /sys sysfs defaults 0 0\n"
"devtmpfs /dev devtmpfs defaults 0 0\n"
"tmpfs /tmp tmpfs defaults,nosuid,nodev 0 0\n"
),
"etc/issue": f"NEXUS OS v{VERSION} — {self.project.name}\n",
"etc/profile": (
"export PATH=/bin:/sbin:/usr/bin:/usr/sbin\n"
"export HOME=/root\n"
f"export NEXUS_VERSION={VERSION}\n"
),
"etc/nexus/release": (
f"NEXUS OS v{VERSION}\n"
f"Name: {self.project.name}\n"
f"Distro: {self.project.distro}\n"
f"Built: {datetime.now().isoformat()}\n"
f"Prompt: {self.project.prompt}\n"
),
}

for path, content in files.items():
fp = self.rootfs / path
fp.parent.mkdir(parents=True, exist_ok=True)
fp.write_text(content)
if "shadow" in path:
os.chmod(fp, 0o600)

def _create_init(self):
"""Crée le script /init."""
init = f"""#!/bin/sh
# NEXUS OS — {self.project.name}
# Built: {datetime.now().isoformat()}

export PATH=/bin:/sbin:/usr/bin:/usr/sbin
export HOME=/root

mount -t proc proc /proc 2>/dev/null
mount -t sysfs sysfs /sys 2>/dev/null
mount -t devtmpfs devtmpfs /dev 2>/dev/null
mount -t tmpfs tmpfs /tmp 2>/dev/null

clear 2>/dev/null || true

echo ""
echo "╔════════════════════════════════════════════════════════════╗"
echo "║ ║"
echo "║ NEXUS OS v{VERSION} ║"
echo "║ {self.project.name:<44}║"
echo "║ Distro: {self.project.distro:<37}║"
echo "║ ║"
echo "╚════════════════════════════════════════════════════════════╝"
echo ""

exec /bin/sh
"""
init_path = self.rootfs / "init"
init_path.write_text(init)
os.chmod(init_path, 0o755)

def _create_shell(self):
"""Crée le shell minimal."""
sh = """#!/bin/sh
while true; do
printf "nexus@os:\\w# "
read cmd
case "$cmd" in
exit|quit) exit 0 ;;
help) echo "Commandes: exit, help, info, ls, echo, uname, pwd, date, cat" ;;
info) cat /etc/nexus/release 2>/dev/null ;;
ls) ls / ;;
pwd) pwd ;;
date) date ;;
uname) uname -a ;;
"") ;;
*) echo "nexus: commande non disponible en mode minimal" ;;
esac
done
"""
sh_path = self.rootfs / "bin/sh"
sh_path.parent.mkdir(parents=True, exist_ok=True)
sh_path.write_text(sh)
os.chmod(sh_path, 0o755)

